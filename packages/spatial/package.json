  },
  "license": "MIT",
  "author": "vizcrush contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-diary-1/vizcrush.git",
    "directory": "packages/spatial"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
