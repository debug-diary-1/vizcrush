{
  "name": "@vizcrush/core",
  "version": "2.0.0",
  "description": "Shared WASM/JS dispatch kernel and capability detection for vizcrush packages",
  "keywords": [
    "data",
    "simd",
    "visualization",
    "wasm"
  ],
  "homepage": "https://github.com/debug-diary-1/vizcrush#readme",
  "bugs": {
    "url": "https://github.com/debug-diary-1/vizcrush/issues"
  },
  "license": "MIT",
  "author": "vizcrush contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-diary-1/vizcrush.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
