{
  "name": "vizcrush-monorepo",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm build:wasm && pnpm turbo build",
    "test": "pnpm test:all",
    "test:rust": "cargo test --workspace",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm turbo typecheck",
    "bench": "pnpm --filter vizcrush-benchmarks run bench",
    "test:vitest": "npx vitest run",
    "test:all": "cargo test --workspace && npx vitest run",
    "test:examples": "bash scripts/test-examples.sh",
    "test:browser:packed": "node scripts/test-packed-browser.mjs",
    "examples": "vite examples",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:inventory:check": "node scripts/check-doc-inventories.mjs",
    "docs:inventory:write": "node scripts/check-doc-inventories.mjs --write",
    "check:dependency-policy": "node scripts/check-dependency-policy.mjs",
    "examples:build": "bash scripts/build-examples.sh",
    "docs:preview": "vitepress preview docs",
    "check:example-claims": "node scripts/check-example-claims.mjs",
    "check:turbo-tasks": "node scripts/check-turbo-tasks.mjs"
  },
  "devDependencies": {
    "d3-array": "catalog:",
    "downsample": "catalog:",
    "fast-check": "catalog:",
    "kdbush": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "rbush": "catalog:",
    "simple-statistics": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
